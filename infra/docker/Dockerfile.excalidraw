# Excalidraw MCP + Canvas + Streamable HTTP Gateway (single container)
#   port 3000: Canvas Server (REST + WebSocket + frontend)
#   port 8000: supergateway streamableHttp  /mcp  /healthz
# ACA では internal-only ingress (port 8000) で公開する。Public IP なし。
#
# build context = リポジトリルート:
#   docker build -f infra/docker/Dockerfile.excalidraw -t excalidraw-mcp:local my-mcp-server/mcp_excalidraw

FROM node:20-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:20-slim
WORKDIR /app
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000 \
    ENABLE_CANVAS_SYNC=true \
    EXPRESS_SERVER_URL=http://127.0.0.1:3000 \
    GATEWAY_PORT=8000
COPY --from=build /app/dist ./dist
COPY --from=build /app/package*.json ./
RUN npm ci --omit=dev && npm install -g supergateway@latest \
    && addgroup --system app && adduser --system --ingroup app app \
    && mkdir -p /app/logs /app/exports && chown -R app:app /app
USER app

# canvas server + gateway を同一コンテナで起動 (PoC 構成)
COPY --chown=app:app <<'EOF' /app/entrypoint.sh
#!/bin/sh
set -e
node dist/server.js &
CANVAS_PID=$!
sleep 2
exec supergateway \
  --stdio "env ENABLE_CANVAS_SYNC=true EXPRESS_SERVER_URL=http://127.0.0.1:3000 node /app/dist/index.js" \
  --outputTransport streamableHttp \
  --port "${GATEWAY_PORT}" \
  --streamableHttpPath /mcp \
  --healthEndpoint /healthz \
  --logLevel info
EOF
RUN chmod +x /app/entrypoint.sh || true

EXPOSE 3000 8000
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://127.0.0.1:8000/healthz || exit 1
ENTRYPOINT ["/bin/sh", "/app/entrypoint.sh"]
