# cc-tools MCP server (FastMCP, streamable HTTP, port 8080)
# build context = リポジトリルート:
#   docker build -f infra/docker/Dockerfile.cctools -t cc-tools:local .

FROM python:3.11-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    CC_TOOLS_HOST=0.0.0.0 \
    CC_TOOLS_PORT=8080 \
    EXCALIDRAW_MCP_URL=http://excalidraw-mcp:8000/mcp

COPY pyproject.toml ./
COPY schemas/ ./schemas/
COPY src/ ./src/
RUN pip install --no-cache-dir . \
    && addgroup --system app && adduser --system --ingroup app app
USER app

EXPOSE 8080
CMD ["python", "-m", "cc_tools.server"]
