{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qst.internal/concept-cartographer/layout_plan.schema.json",
  "title": "Concept Cartographer layout_plan (R1: 可変詳細度対応)",
  "description": "Excalidraw への中間契約 (引き継ぎメモ §9 / 実運用計画 §4)。3 段階の詳細度 (overview/standard/detailed) を 1 ファイルに同梱し、切替は再生成なしにクライアント側で完結する (v3 §2.4)。",
  "type": "object",
  "required": [
    "nodes",
    "edges",
    "islands",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "detail_level": {
      "type": "string",
      "enum": [
        "overview",
        "standard",
        "detailed"
      ],
      "default": "standard"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "x",
          "y",
          "size",
          "community_id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "size": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "ノードの幅 (px)"
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "ノードの高さ (px)。省略時は size から算出"
          },
          "community_id": {
            "type": "string",
            "minLength": 1
          },
          "style": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "rough": {
                "type": "boolean",
                "default": true
              },
              "backgroundColor": {
                "type": "string"
              },
              "strokeColor": {
                "type": "string"
              }
            }
          },
          "importance": {
            "type": "object",
            "description": "重要度スコアの内訳 (v3 §2.4: 媒介中心性/出現頻度/新規性)",
            "additionalProperties": false,
            "properties": {
              "betweenness": {
                "type": "number"
              },
              "frequency": {
                "type": "number"
              },
              "novelty": {
                "type": "number"
              },
              "total": {
                "type": "number"
              }
            }
          },
          "visible_at": {
            "type": "object",
            "description": "どの詳細度で表示するか",
            "additionalProperties": false,
            "properties": {
              "overview": {
                "type": "boolean"
              },
              "standard": {
                "type": "boolean"
              },
              "detailed": {
                "type": "boolean"
              }
            }
          },
          "kind": {
            "type": "string",
            "enum": [
              "concept",
              "aggregate"
            ],
            "default": "concept",
            "description": "aggregate = 非表示メンバーを畳んだ集約ノード"
          },
          "aggregate_id": {
            "type": "string",
            "description": "kind=aggregate のとき対応する aggregates[].id"
          },
          "evidence_span": {
            "type": "array",
            "description": "関係を導出した原文スパン。surface (原文の逐語引用) は必須。char_start/char_end は取得元が返す場合のみ (Work IQ の copilot_chat はオフセットを返さないため、その場合の trace back は document 粒度)。",
            "items": {
              "type": "object",
              "required": [
                "surface"
              ],
              "additionalProperties": true,
              "properties": {
                "document_id": {
                  "type": "string"
                },
                "char_start": {
                  "type": "integer",
                  "description": "原文の開始位置。取得元が文字オフセットを返さない場合は省略"
                },
                "char_end": {
                  "type": "integer"
                },
                "surface": {
                  "type": "string"
                }
              }
            }
          },
          "origin": {
            "type": "string",
            "enum": [
              "ai",
              "user_edited",
              "user_added"
            ],
            "description": "要素の出所 (編集/学習設計書 §2)。無印は AI 生成。user_* はユーザーが編集/追加したもので、因果精度 KPI の分母からは除外する。"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "glyph"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "glyph": {
            "type": "string",
            "enum": [
              "arrow",
              "wave",
              "zigzag",
              "double",
              "hole",
              "tension"
            ],
            "description": "arrow=因果(3点セット通過時のみ) / wave=相関 / zigzag=矛盾(L8導入後) / double=補強 / hole=ギャップ候補 / tension=対立候補(非断定, R1)"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_span": {
            "type": "array",
            "description": "関係を導出した原文スパン。surface (原文の逐語引用) は必須。char_start/char_end は取得元が返す場合のみ (Work IQ の copilot_chat はオフセットを返さないため、その場合の trace back は document 粒度)。",
            "items": {
              "type": "object",
              "required": [
                "surface"
              ],
              "additionalProperties": true,
              "properties": {
                "document_id": {
                  "type": "string"
                },
                "char_start": {
                  "type": "integer",
                  "description": "原文の開始位置。取得元が文字オフセットを返さない場合は省略"
                },
                "char_end": {
                  "type": "integer"
                },
                "surface": {
                  "type": "string"
                }
              }
            }
          },
          "epistemic_status": {
            "type": "string",
            "enum": [
              "asserted",
              "hedged",
              "hypothesized",
              "observed",
              "concluded"
            ],
            "description": "著者の断定強度 (confidence とは独立, v4核§4.3)"
          },
          "polarity": {
            "type": "string",
            "enum": [
              "positive",
              "negative",
              "neutral"
            ]
          },
          "provenance": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "extractor_model": {
                "type": "string"
              },
              "timestamp": {
                "type": "string"
              },
              "validator_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "human_reviewed": {
                "type": "boolean"
              }
            }
          },
          "causal_check": {
            "type": "object",
            "description": "因果3点セット検証の記録 (計画 裁定7)",
            "additionalProperties": true,
            "properties": {
              "lexicon_hit": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "verifier_verdict": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "skipped"
                ]
              },
              "demoted_from": {
                "type": "string"
              }
            }
          },
          "visible_at": {
            "type": "object",
            "description": "どの詳細度で表示するか",
            "additionalProperties": false,
            "properties": {
              "overview": {
                "type": "boolean"
              },
              "standard": {
                "type": "boolean"
              },
              "detailed": {
                "type": "boolean"
              }
            }
          },
          "member_edge_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "縮約エッジが代表している元エッジ (内部情報を失わない, v4核§6.4)"
          },
          "origin": {
            "type": "string",
            "enum": [
              "ai",
              "user_edited",
              "user_added"
            ],
            "description": "要素の出所 (編集/学習設計書 §2)。無印は AI 生成。user_* はユーザーが編集/追加したもので、因果精度 KPI の分母からは除外する。"
          }
        }
      }
    },
    "islands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "community_id",
          "name",
          "bbox"
        ],
        "additionalProperties": false,
        "properties": {
          "community_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "[x_min, y_min, x_max, y_max]"
          },
          "is_gap": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "graph_version",
        "generated_for"
      ],
      "additionalProperties": true,
      "properties": {
        "graph_version": {
          "type": "string",
          "minLength": 1
        },
        "generated_for": {
          "type": "string",
          "minLength": 1
        },
        "layout_engine": {
          "type": "string"
        },
        "language": {
          "type": "string"
        }
      }
    },
    "levels": {
      "type": "object",
      "description": "各詳細度のノード数 (v3 §2.4 の帯を満たすか検証可能に)",
      "additionalProperties": false,
      "properties": {
        "overview": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nodes": {
              "type": "integer"
            },
            "edges": {
              "type": "integer"
            },
            "aggregates": {
              "type": "integer"
            },
            "pinned": {
              "type": "integer",
              "description": "そのレベルで表示中の、編集によりピン留めされたノード数 (§4.1)"
            }
          }
        },
        "standard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nodes": {
              "type": "integer"
            },
            "edges": {
              "type": "integer"
            },
            "aggregates": {
              "type": "integer"
            },
            "pinned": {
              "type": "integer",
              "description": "そのレベルで表示中の、編集によりピン留めされたノード数 (§4.1)"
            }
          }
        },
        "detailed": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nodes": {
              "type": "integer"
            },
            "edges": {
              "type": "integer"
            },
            "aggregates": {
              "type": "integer"
            },
            "pinned": {
              "type": "integer",
              "description": "そのレベルで表示中の、編集によりピン留めされたノード数 (§4.1)"
            }
          }
        }
      }
    },
    "aggregates": {
      "type": "array",
      "description": "集約ノード定義 (ドリルダウンの対応表, v3 §2.4④)",
      "items": {
        "type": "object",
        "required": [
          "id",
          "community_id",
          "summary_label",
          "member_node_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "community_id": {
            "type": "string"
          },
          "summary_label": {
            "type": "string"
          },
          "member_node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "representative_node_id": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "description": "ギャップ候補 (確定は人間, 計画 裁定8 / G4)",
      "items": {
        "type": "object",
        "required": [
          "gap_id",
          "status",
          "confidence",
          "presumed_type",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "gap_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "candidate",
              "confirmed",
              "dismissed"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "presumed_type": {
            "type": "string",
            "enum": [
              "data",
              "extraction",
              "true",
              "unknown"
            ]
          },
          "reason": {
            "type": "string"
          },
          "evidence_links": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "related_node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "community_id": {
            "type": "string"
          },
          "confirmed_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "confirmed_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "_level_plans": {
      "type": "object",
      "description": "各詳細度の完成 plan を同梱する。切替時に再レイアウトしないため (v3 §2.4「再生成を伴わずクライアント側で完結」)。cc_core.detail.project() で取り出す。",
      "additionalProperties": true
    },
    "_needs_recompute": {
      "type": "boolean",
      "description": "同梱が無く再計算が必要 (UI は進捗表示へ切り替える, v3 §2.4)"
    }
  }
}
